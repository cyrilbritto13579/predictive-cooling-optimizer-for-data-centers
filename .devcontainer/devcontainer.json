{
  "name": "Predictive Cooling Optimizer (React + FastAPI)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "backend/main.py",
        "frontend/src/App.tsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt; if command -v node > /dev/null; then cd frontend && npm install; fi; echo 'Dependencies installed'",
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "React Frontend",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000,
    5173
  ]
}
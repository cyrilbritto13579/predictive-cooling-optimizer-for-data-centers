# Predictive Cooling Optimizer - Backend Environment Configuration

# Server listen port
PORT=8000

# Comma-separated allowed frontend origins for CORS
# In production, replace with your actual frontend domain
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://your-frontend-domain.vercel.app

# Application environment: development | production
ENVIRONMENT=production
